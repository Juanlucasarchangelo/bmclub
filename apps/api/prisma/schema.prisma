
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  COMPANY
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  FINISHED
}

enum RegistrationStatus {
  CONFIRMED
  CANCELLED
  WAITLIST
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum SpaceCategory {
  ATMOS
  SALA
}

model Company {
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String

  // Dados pessoais
  cpf   String? @unique @db.VarChar(11)
  phone String? @db.VarChar(20)

  // Preferências e restrições alimentares
  dietaryRestrictions String? @db.Text

  // Permissões e situação da conta
  role      UserRole @default(MEMBER)
  active    Boolean  @default(true)
  deletedAt DateTime?

  // Empresa vinculada
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  // Relacionamentos
  registrations EventRegistration[]
  reservations  Reservation[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  whatsAppCampaigns WhatsAppCampaign[] @relation("WhatsAppCampaignAuthor")

  @@index([role, active])
  @@index([companyId])
}


model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model Guest {
  id             String            @id @default(cuid())
  name           String
  email          String?
  phone          String?
  registrationId String
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  status      EventStatus @default(DRAFT)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRegistration {
  id      String             @id @default(cuid())
  eventId String
  userId  String
  seats   Int                @default(1)
  status  RegistrationStatus @default(CONFIRMED)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  guests Guest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

model Space {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  capacity    Int
  category    SpaceCategory @default(SALA)
  active      Boolean       @default(true)

  reservations  Reservation[]
  blockedPeriods BlockedPeriod[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
}

model Reservation {
  id       String @id @default(cuid())
  spaceId  String
  userId   String
  startsAt DateTime
  endsAt   DateTime
  guests   Int    @default(1)
  notes    String?

  status ReservationStatus @default(CONFIRMED)

  space Space @relation(fields: [spaceId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId, startsAt, endsAt])
  @@index([userId])
}

model BlockedPeriod {
  id       String   @id @default(cuid())
  spaceId  String
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([spaceId, startsAt, endsAt])
}


model WhatsAppCampaign {
  id             String   @id @default(cuid())
  title          String   @db.VarChar(140)
  templateName   String   @db.VarChar(120)
  language       String   @default("pt_BR")
  messagePreview String   @db.Text
  consentSource  String   @db.VarChar(255)
  requestId      String   @unique
  status         String   @default("QUEUED")

createdById String
createdBy   User @relation("WhatsAppCampaignAuthor", fields: [createdById], references: [id])

  recipients WhatsAppRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById, createdAt])
}

model WhatsAppRecipient {
  id         String @id @default(cuid())
campaignId String
campaign   WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  name              String
  phone             String @db.VarChar(16)
  personalizedText  String @db.Text
  status            String @default("PENDING")
  providerMessageId String? @db.VarChar(255)
  error             String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId, status])
}
